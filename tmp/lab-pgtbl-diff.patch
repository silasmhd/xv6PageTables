+int
+pgaccess(pagetable_t pagetable, uint64 base, int len, uint64 user_mask)
+{
+  uint64 va = PGROUNDDOWN(base);
+  uint64 bitmask = 0;
+
+  for (int i = 0; i < len; i++) {
+    pte_t *pte = walk(pagetable, va, 0);
+    if (pte == 0 || (*pte & PTE_V) == 0)
+      return -1;
+
+    if (*pte & PTE_A) {
+      bitmask |= (1ULL << i);
+      *pte &= ~PTE_A; // Clear the accessed bit
+    }
+
+    va += PGSIZE;
+  }
+
+  if (copyout(pagetable, user_mask, (char *)&bitmask, sizeof(bitmask)) < 0)
+    return -1;
+
+  return 0;
+}
